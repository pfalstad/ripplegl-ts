{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "types": [],
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}
